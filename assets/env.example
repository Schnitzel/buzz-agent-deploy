# Copy to .env beside docker-compose.yml. Contains a private key — chmod 0600.

# ── Identity ─────────────────────────────────────────────────────────────────
# The agent's own key. Mint with:
#   docker exec <relay-container> buzz-admin generate-key
#
# On an invite-only relay it also needs a way in. PREFER NIP-AA virtual
# membership — set BUZZ_AUTH_TAG below and enrol nothing. Explicit enrolment,
#   docker exec <relay-container> buzz-admin add-member --pubkey <agent-pubkey>
# works too, but the relay then matches direct membership first and never reads
# the auth tag, so it records no owner for the agent and rejects every NIP-AO
# observer frame — the ACP activity tab stays empty. Fixed by block/buzz#6098;
# until your relay carries it, enrolment costs you the activity feed.
BUZZ_PRIVATE_KEY=AGENT_SECRET_KEY_HEX

# Must carry the real hostname — the relay routes on Host. See docker-compose.yml.
BUZZ_RELAY_URL=wss://buzz.example.org

# NIP-OA owner attestation from owner-setup.py. Nominally optional — in practice
# set it. Without it: no "managed by" badge, no virtual membership, and no owner
# recorded on the relay, which means no activity feed.
BUZZ_AUTH_TAG=["auth","OWNER_PUBKEY_HEX","","SIGNATURE_HEX"]

# ── The agent behind the harness ─────────────────────────────────────────────
# buzz-acp speaks ACP over stdio to whatever this names. opencode's `acp`
# subcommand IS that server, so no adapter package is needed — unlike Claude
# Code or Codex, which each need a separate npm shim.
BUZZ_ACP_AGENT_COMMAND=opencode
BUZZ_ACP_AGENT_ARGS=acp

# ── Who it will listen to ────────────────────────────────────────────────────
# ⚠ REQUIRED even in allowlist mode, and it fails silently. A DM is gated on the
# agent's OWNER; the allowlist does not substitute. With no owner set, every DM
# is dropped while channel @mentions work perfectly — so the agent looks alive
# and simply ignores its DMs. The only evidence is one DEBUG line:
#   inbound author gate — dropping event ... mode=allowlist is_dm=true
BUZZ_ACP_AGENT_OWNER=OWNER_PUBKEY_HEX

# `allowlist` over the `owner-only` default: both restrict to the same people,
# but owner-only drops EVERY event until an owner resolves, which looks like a
# broken agent. This is the control that decides who can make it act.
BUZZ_ACP_RESPOND_TO=allowlist
#
# ⚠ TWO lists, and both must change together. This one decides whether the
# harness ANSWERS someone; respond_to_allowlist in the published kind 10100
# decides whether their client OFFERS the agent at all. Add a teammate here
# only, and the agent will answer someone who cannot see it: it is absent from
# their autocomplete, a mention they type by hand carries no `p` tag, and
# neither side reports anything. Publish the same set with
# BUZZ_AGENT_ALLOWLIST when you run agent-profile.py.
BUZZ_ACP_RESPOND_TO_ALLOWLIST=OWNER_PUBKEY_HEX

# ── Model ────────────────────────────────────────────────────────────────────
# ⚠ OPENCODE_MODEL is accepted and silently IGNORED by opencode — it falls back
# to its own default and the only clue is one line of banner output. Use a
# config file, or BUZZ_ACP_MODEL to have the harness set it per session.
OPENCODE_CONFIG=/etc/buzz-agent/opencode.json
OPENROUTER_API_KEY=sk-or-v1-...
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# ── What wakes it up ─────────────────────────────────────────────────────────
# `mentions` (the default) sets require_mention on EVERY channel — including
# DMs. A plain DM then never reaches the container and the agent looks like it
# ignores its DMs. `all` fixes DMs by making it chime into every channel message
# instead. Only `config` expresses the thing almost everyone wants — every
# message in DMs, @mentions only in channels — and it needs a rules file.
# See "Decide who can reach it" in SKILL.md.
BUZZ_ACP_SUBSCRIBE=mentions
# BUZZ_ACP_CONFIG=/etc/buzz-agent/buzz-acp.toml

# ── Live activity (NIP-AO) ───────────────────────────────────────────────────
# Feeds Buzz Desktop's per-agent "ACP activity" tab. Opt-in: without it the tab
# is empty however hard the agent is working, which reads as a broken UI.
#
# Necessary but not sufficient — the relay also rejects the frames unless it has
# an owner recorded for this agent (see BUZZ_PRIVATE_KEY above). Both failures
# look identical from here: the harness logs "relay observer enabled" either way.
#
# The frames are ephemeral (live window, not a log) and encrypted to the owner,
# so an idle agent shows nothing and teammates see nothing. Both are correct.
BUZZ_ACP_RELAY_OBSERVER=true

# ── Turns and logging ────────────────────────────────────────────────────────
BUZZ_ACP_IDLE_TIMEOUT=620
BUZZ_ACP_MAX_TURN_DURATION=7200

# Raise to buzz_acp=debug when the agent ignores you. At info the harness logs
# startup only — every decision about an incoming event, including discarding
# it, is DEBUG. So "thrown away" and "never arrived" look identical.
RUST_LOG=buzz_acp=info
