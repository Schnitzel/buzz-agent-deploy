# EnvironmentFile for the native systemd service. Contains a private key —
# chmod 600, owned by the agent user. Referenced by buzz-acp.service.

# ── Identity ─────────────────────────────────────────────────────────────────
BUZZ_PRIVATE_KEY=AGENT_SECRET_KEY_HEX
BUZZ_RELAY_URL=wss://buzz.example.org

# NIP-OA owner attestation from owner-setup.py. On a closed relay this is ALSO
# the credential the agent connects with (NIP-AA virtual membership) — and the
# buzz CLI needs it too, or its REST calls get 403 relay_membership_required.
BUZZ_AUTH_TAG=["auth","OWNER_PUBKEY_HEX","","SIGNATURE_HEX"]

# ── The agent behind the harness ─────────────────────────────────────────────
BUZZ_ACP_AGENT_COMMAND=opencode
BUZZ_ACP_AGENT_ARGS=acp

# ── Model — pin it here ──────────────────────────────────────────────────────
# A freshly-spawned opencode with no configured default model silently picks a
# wrong one (a Gemini image-preview model). Your interactive sessions set the
# model via their client; the harness spawns fresh sessions that do NOT inherit
# it. BUZZ_ACP_MODEL makes the harness set the model on every new session.
BUZZ_ACP_MODEL=openrouter/moonshotai/kimi-k3

# ── Who it will listen to ────────────────────────────────────────────────────
BUZZ_ACP_AGENT_OWNER=OWNER_PUBKEY_HEX
BUZZ_ACP_RESPOND_TO=allowlist
BUZZ_ACP_RESPOND_TO_ALLOWLIST=OWNER_PUBKEY_HEX

# ── Live activity (NIP-AO) ───────────────────────────────────────────────────
# Feeds Buzz Desktop's per-agent "ACP activity" tab; empty without it. Also
# requires the relay to have an owner recorded for this agent — which it does
# if BUZZ_AUTH_TAG above admitted it as a virtual member, and does NOT if the
# agent was enrolled with `buzz-admin add-member` on a relay predating
# block/buzz#6098.
BUZZ_ACP_RELAY_OBSERVER=true

# ── Turns and logging ────────────────────────────────────────────────────────
BUZZ_ACP_IDLE_TIMEOUT=900
BUZZ_ACP_MAX_TURN_DURATION=10800
RUST_LOG=buzz_acp=info
